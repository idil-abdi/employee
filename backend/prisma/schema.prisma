generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

model Employee {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String     @unique
  description  String?
  mobileNumber String
  address      String
  dateOfBirth  DateTime
  hireDate     DateTime
  department   String
  contracts    Contract[]

  @@map("employees")
}

model Contract {
  id           String       @id @default(uuid())
  title        String?
  contractType ContractType // part time, fullt ime or contract
  startDate    DateTime
  endDate      DateTime?
  salary       Float?
  weeklyHours  Int
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@map("contracts")
}
